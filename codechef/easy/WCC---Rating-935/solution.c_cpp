#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int X;
        string s;

        cin >> X;
        cin >> s;

        int carlsen = 0;
        int chef = 0;

        for (int i = 0; i < 14; i++) {

            if (s[i] == 'C') {
                carlsen += 2;
            }
            else if (s[i] == 'N') {
                chef += 2;
            }
            else {
                carlsen++;
                chef++;
            }
        }

        if (carlsen > chef) {
            cout << 60 * X << endl;
        }
        else if (carlsen == chef) {
            cout << 55 * X << endl;
        }
        else {
            cout << 40 * X << endl;
        }
    }

    return 0;
}
#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n, k;
    cin >> n >> k;
    vector<long long> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }
    
    sort(a.rbegin(), a.rend());
    
    if (k >= n - 1) {
        long long total_sum = 0;
        for (long long x : a) {
            total_sum += x;
        }
        cout << total_sum << "\n";
    } else {
        long long max_water = 0;
        for (int i = 0; i <= k; i++) {
            max_water += a[i];
        }
        cout << max_water << "\n";
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
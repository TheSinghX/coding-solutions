#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        map<long long, int> freq;

        for (int i = 0; i < n; i++) {
            long long x;
            cin >> x;
            freq[x]++;
        }

        int mx = 0;

        for (auto p : freq) {
            mx = max(mx, p.second);
        }

        cout << (mx + 1) / 2 << '\n';
    }

    return 0;
}
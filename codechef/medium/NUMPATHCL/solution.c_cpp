#include <bits/stdc++.h>
using namespace std;
const long long MOD = 1e9+7;

int main() {
	ios::sync_with_stdio(false);
	cin.tie(nullptr);
	
	int N, B;
	cin >> N >> B;
	vector<int> n(N+1);
	for(int i=1;i<=N;i++)
	cin >> n[i];
	
	vector<long long> f(N+2, 0), S(N+2, 0);
	
	f[B] = 1;
	S[B] = 1;
	
	for(int i=B-1;i>=1;i--){
	    int hi = min(i+n[i], B);
	    if(hi > i){
	        long long val = (S[i+1] - S[hi+1] % MOD + MOD) % MOD;
	        f[i] = val;
	    }else {
	        f[i] =0;
	    }
	    S[i] = (f[i] + S[i+1]) % MOD;
	}
	int Q;
	cin >> Q;
	while(Q--){
	    int A;
	    cin >> A;
	    cout << f[A] << " \n";
	}
	return 0;

}

#include <bits/stdc++.h>
using namespace std;

void solve() {
    long long n;
    cin >> n;
    
    long long total_pairs = 0;
    long long l = 1;
    
    while (l <= n) {
        long long q = n / l;
        long long r = n / q;
        
        total_pairs += (q - 1) * (r - l + 1);
        
        l = r + 1;
    }
    
    cout << total_pairs << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    long long k;
    cin >> n >> k;
    
    vector<long long> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }
    
    priority_queue<long long, vector<long long>, greater<long long>> pq(a.begin(), a.end());
    
    for (long long i = 0; i < k; i++) {
        long long x = pq.top();
        pq.pop();
        
        if (pq.empty()) {
            pq.push(x);
        } else {
            long long y = pq.top();
            pq.pop();
            pq.push(x + y);
        }
    }
    
    long long max_water = 0;
    while (!pq.empty()) {
        max_water = max(max_water, pq.top());
        pq.pop();
    }
    
    cout << max_water << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
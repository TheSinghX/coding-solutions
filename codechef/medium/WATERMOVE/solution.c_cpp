#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    scanf("%d", &t);
    while (t--) {
        int n, k;
        scanf("%d %d", &n, &k);
        vector<int> a(n);
        for (int &x : a) scanf("%d", &x);
        sort(a.begin(), a.end());
        printf("%d\n", max(a[n - 1], a[0] + a[1]));
    }
    return 0;
}
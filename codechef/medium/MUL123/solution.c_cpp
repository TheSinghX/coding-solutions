#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        if (N % 3 == 0) {
            cout << 0 << '\n';
        }
        else if ((N + 1) % 3 == 0) {
            cout << 1 << '\n';
        }
        else {
            int next5 = ((N / 5) + 1) * 5;

            if (next5 % 3 == 0)
                cout << 1 << '\n';
            else
                cout << 2 << '\n';
        }
    }

    return 0;
}
#include <bits/stdc++.h>
using namespace std;
int main(){
    int t; scanf("%d",&t);
    while(t--){
        int n; scanf("%d",&n);
        vector<int> p(n+1);
        for(int i=1;i<=n;i++) scanf("%d",&p[i]);
        auto f=[&](){int c=0;for(int i=1;i<=n;i++)c+=p[i]==i;return c;};
        int best=f();
        for(int l=1;l<=n;l++)for(int r=l;r<=n;r++){
            reverse(p.begin()+l,p.begin()+r+1);
            best=max(best,f());
            reverse(p.begin()+l,p.begin()+r+1);
        }
        printf("%d\n",best);
    }
}
#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        string S;
        cin >> N >> S;

        if (S.find("01") != string::npos)
            cout << "01\n";
        else
            cout << S << '\n';
    }

    return 0;
}
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        long long x, y;
        cin >> x >> y;

        for (int d = 1; ; d++) {
            long long best = 0;

            for (int k = 0; k <= d; k++) {
                long long profit = -x * k;

                for (int i = 1; i <= k; i++)
                    profit += y * i * i;

                profit += 1LL * (d - k) * y * k * k;

                best = max(best, profit);
            }

            if (best > 0) {
                cout << d << '\n';
                break;
            }
        }
    }

    return 0;
}
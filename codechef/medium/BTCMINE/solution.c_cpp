#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int x, y;
        cin >> x >> y;

        long long profit = 0;
        int days = 0;
        int gpu = 0;

        while (profit <= 0) {
            days++;
            gpu++;
            profit -= x;
            profit += 1LL * y * gpu * gpu;
        }

        cout << days << '\n';
    }

    return 0;
}